# Copy this file to .env.local and fill in your values

# Booking System (GlossGenius, Square, etc.)
NEXT_PUBLIC_BOOKING_URL=https://your-booking-url.com

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXX

# Contact
NEXT_PUBLIC_CONTACT_EMAIL=hello@lumscharms.com
NEXT_PUBLIC_CONTACT_PHONE=+15551234567
NEXT_PUBLIC_WHATSAPP_NUMBER=15551234567

# Social Media
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/thelumscharms
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@thelumscharms
NEXT_PUBLIC_PINTEREST_URL=https://pinterest.com/thelumscharms
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/thelumscharms

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-api-key
NEXT_PUBLIC_SALON_ADDRESS="123 Charm Street, Luxury District, LD 90210"

# CMS (if using Sanity or other headless CMS)
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_API_VERSION=2023-10-01
SANITY_API_TOKEN=your-token

# Email Service (for contact forms)
EMAIL_SERVICE_API_KEY=your-api-key
EMAIL_FROM_ADDRESS=noreply@lumscharms.com
EMAIL_TO_ADDRESS=hello@lumscharms.com
